{
  "name": "storm-watcher",
  "private": true,
  "engines": {
    "node": ">=20 <27"
  },
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/generate_sitemap.py && vite build && node scripts/prerender-meta.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p api/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "sitemap": "python3 scripts/generate_sitemap.py",
    "check:vercel": "node scripts/check-vercel-config.mjs",
    "smoke": "node scripts/smoke-production.mjs",
    "ios:deploy": "bash scripts/ios-deploy.sh",
    "ios:open": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:livereload": "npx cap run ios --livereload --external",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "@sentry/react": "^10.50.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.183.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.4",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-globe.gl": "^2.37.1",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.5",
    "react-joyride": "^3.0.2",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.14.0",
    "satellite.js": "^4.1.4",
    "solar-calculator": "^0.3.0",
    "stripe": "^22.1.0",
    "three": "^0.184.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "bash -c 'tsc --noEmit -p tsconfig.app.json'"
    ],
    "api/**/*.ts": [
      "eslint --max-warnings 0",
      "bash -c 'tsc --noEmit -p api/tsconfig.json'"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "smol-toml": "^1.6.1",
    "undici": "^7.25.0",
    "tar": ">=7.4.3",
    "uuid": ">=11.1.1",
    "path-to-regexp": ">=6.3.0",
    "minimatch": ">=3.1.4",
    "sharp": ">=0.35.0",
    "js-yaml": ">=4.3.1",
    "@vercel/static-config": {
      "ajv": ">=8.18.0"
    }
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.8.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.9.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  }
}

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Stripe (publishable key only — secrets stay in Vercel env vars) ───────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to true to enable Stripe payments and plan gating in the UI.
# Keep false during development so all features are accessible.
VITE_PAYMENTS_ENABLED=false

# ── Dev-only: Stripe checkout/portal allowed origin ───────────────────────────
# Removed automatically in production (Vercel env vars don't set this).
ALLOWED_DEV_ORIGIN=http://localhost:5173

# ── Server-side secrets (Vercel environment variables only — never commit) ────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# RESEND_API_KEY=re_...
# VAPID_PUBLIC_KEY=<vapid-public>
# VAPID_PRIVATE_KEY=<vapid-private>
# VAPID_EMAIL=mailto:admin@thestormwatcher.com
# CRON_SECRET=<random-secret-for-cron-jobs>
# APNS_PRIVATE_KEY_P8=<apple-push-p8-key>
# APNS_KEY_ID=<apple-key-id>
# APNS_TEAM_ID=<apple-team-id>
# APPLE_SHARED_SECRET=<app-store-connect-shared-secret>     # for verify-iap
# GOOGLE_SERVICE_ACCOUNT=<service-account-json-string>      # for verify-iap

{
  "rewrites": [
    {
      "source": "/donki/:path*",
      "destination": "https://kauai.ccmc.gsfc.nasa.gov/DONKI/WS/get/:path*"
    },
    {
      "source": "/api/niggg/:path*",
      "destination": "https://pagmag.ngic.bg/:path*"
    },
    {
      "source": "/api/gfz/:path*",
      "destination": "https://kp.gfz.de/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

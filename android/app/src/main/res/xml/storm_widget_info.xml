<?xml version="1.0" encoding="utf-8"?>
<!-- 30 min is the platform floor for updatePeriodMillis; anything smaller is
     silently clamped. The widget also refreshes whenever the launcher rebinds
     it, and KpSource caches for 5 min so several instances share one fetch. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/storm_widget_preview"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/storm_widget_preview" />

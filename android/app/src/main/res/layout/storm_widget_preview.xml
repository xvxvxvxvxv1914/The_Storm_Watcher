<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the widget picker on API 31+. Static by design: the picker renders
     this layout, it does not run provideGlance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/storm_widget_background"
    android:padding="12dp"
    tools:ignore="HardcodedText,SmallSp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STORM WATCHER"
        android:textColor="#66FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2.3"
        android:textColor="#10B981"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_quiet"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="420 km/s"
        android:textColor="#BF10B981"
        android:textSize="9sp" />
</LinearLayout>

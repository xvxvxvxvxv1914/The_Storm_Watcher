<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>bg</string>
		<string>da</string>
		<string>de</string>
		<string>es</string>
		<string>fi</string>
		<string>fr</string>
		<string>is</string>
		<string>ja</string>
		<string>ko</string>
		<string>no</string>
		<string>pl</string>
		<string>ru</string>
		<string>sv</string>
		<string>uk</string>
		<string>zh</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>The Storm Watcher</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>The Storm Watcher uses your location to show local UV index, sunrise/sunset times, and aurora visibility for where you are.</string>
	<key>NSCameraUsageDescription</key>
	<string>The Storm Watcher uses the camera to take aurora photos for the community gallery and your profile picture.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>The Storm Watcher saves aurora screenshots to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>The Storm Watcher accesses your photo library to share aurora and weather photos.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.stormwatcher.widget-refresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stormwatcher</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.stormwatcher.app</string>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.stormwatcher.app.aurora</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Aurora Forecast</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>sparkles</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.stormwatcher.app.alerts</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Storm Alerts</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>bell.badge</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.stormwatcher.app.mood</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Log Mood</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>face.smiling</string>
		</dict>
	</array>
</dict>
</plist>
